@startuml
class ZooGenerator <<static>> {
    + {static} Generate(folder:string, origin:Vector3) : GameObject
    + {static} GroupName(modelName:string) : string
    + {static} GetClips(path:string) : List<AnimationClip>
    + {static} Bounds(target:GameObject) : Bounds
    + {static} Label(parent:Transform, text:string, position:Vector3, size:float, width:float, alignment:TextAlignmentOptions) : TextMeshPro
}
class ZooClipPlayer {
    + speed : float = 1f
}
MonoBehaviour <|-- ZooClipPlayer
ZooClipPlayer --> "clip" AnimationClip
class ZooLighting {
    + Apply(index:int) : void
}
class Preset {
    + name : string = "Day"
    + sunIntensity : float = 1.3f
    + lampsOn : bool = false
}
MonoBehaviour <|-- ZooLighting
ZooLighting --> "sun" Light
ZooLighting o-> "cycleKey" Key
ZooLighting +-- Preset
Preset o-> "sunAngles" Vector3
Preset o-> "sunColour" Color
Preset o-> "skyAmbient" Color
Preset o-> "equatorAmbient" Color
Preset o-> "groundAmbient" Color
@enduml
