  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<size=130%><b><color=#ffd970>AREA 6 - ANIMATION</color></b></size>

    A
    farmyard with animals driven by <b>Animator Controllers</b>, a farm dog on a
    <b>Patrol</b> route, a windmill turned by an <b>Animation Clip</b>, and a barn
    door opened with <b>Animator Triggers</b>.


    <b><color=#9fe3ff>TRY THIS</color></b>

    <size=92%>1.
    Change the windmill clip to spin in 3 seconds instead of 8.

    2. Open AC_Farm_Cow
    and add a transition from Eating straight to Walk.

    3. Make the barn door
    swing the other way (+110).</size>'
  m_isRightToLeft: 0
