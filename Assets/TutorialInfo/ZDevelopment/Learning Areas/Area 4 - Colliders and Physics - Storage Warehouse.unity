  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<size=130%><b><color=#ffd970>AREA 4 - COLLIDERS & PHYSICS</color></b></size>

    A
    warehouse full of <b>Rigidbodies</b>: stacks to topple, crates with different
    <b>Mass</b>, a bouncy <b>ball pit</b>, <b>Collider vs Trigger</b> walls, and
    ramps that test <b>Friction</b>.


    <b><color=#9fe3ff>TRY THIS</color></b>

    <size=92%>1.
    Set the 500 kg crate''s Mass to 1. Now push it.

    2. Tick Is Trigger on the
    red wall. What happens when you walk at it?

    3. Give the rubber ramp the
    Ice material, then press RESET and RELEASE.</size>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
